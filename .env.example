# Copy to .env and adjust. Never commit the real .env.
ENVIRONMENT=development            # development | testing | production
DEBUG=false

# --- Database (pick one) ---
# PostgreSQL (docker-compose default)
DATABASE_URL=postgresql+psycopg2://mfg:mfg_password@db:5432/manufacturing
# MySQL:   mysql+pymysql://mfg:mfg_password@db:3306/manufacturing
# SQLite (quick local run): sqlite:///./manufacturing.db
AUTO_CREATE_TABLES=true            # dev convenience; set false in production and use `alembic upgrade head`

# --- Security ---
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=change-me-to-a-long-random-string-of-at-least-32-characters
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
PASSWORD_RESET_EXPIRE_MINUTES=30
BCRYPT_ROUNDS=12
CORS_ORIGINS=http://localhost:3000   # comma separated; avoid * in production

# --- First Super Admin (created on first start when there are no users) ---
FIRST_SUPERUSER_EMAIL=admin@example.com
FIRST_SUPERUSER_PASSWORD=Admin@12345
FIRST_SUPERUSER_NAME=System Administrator

# --- Rate limiting (in-memory; use Redis for multi-worker deployments) ---
RATE_LIMIT_ENABLED=true
RATE_LIMIT_PER_MINUTE=240
LOGIN_RATE_LIMIT_PER_MINUTE=10

# --- Business thresholds ---
HIGH_REJECTION_THRESHOLD_PERCENT=5.0
HIGH_REJECTION_MIN_UNITS=10
DEADLINE_WARNING_DAYS=2
MAINTENANCE_DUE_WARNING_DAYS=7
SHIFT_UTC_OFFSET_MINUTES=330       # shift times are local wall-clock; 330 = India (UTC+05:30)

# --- Optional background scan (low stock, deadlines, delays, maintenance due ...) ---
ENABLE_BACKGROUND_CHECKS=false
BACKGROUND_CHECK_INTERVAL_SECONDS=300
